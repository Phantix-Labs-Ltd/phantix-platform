# Server-only (vite proxy). Browser config: src/lib/config.ts

# Backend the dev server proxies /api to. Set per environment.
API_PROXY_TARGET=http://127.0.0.1:8000
DEV_PORT=5174

# Sign in with Google (Firebase web config — public values, safe in the bundle).
# Leave empty to hide the Google button. The API must also have FIREBASE_PROJECT_ID.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=graph-679b0.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=graph-679b0
